{
    "name": "file-uploader",
    "version": "0.2.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "eslint . --max-warnings=0",
        "format": "prettier --write .",
        "prepare": "husky",
        "test": "vitest run"
    },
    "lint-staged": {
        "*.{js,jsx,ts,tsx}": "eslint --max-warnings=0",
        "*.{js,jsx,ts,tsx,json,css,md}": [
            "prettier --write",
            "git add"
        ]
    },
    "dependencies": {
        "@radix-ui/react-dialog": "^1.1.15",
        "lucide-react": "^0.540.0",
        "next": "16.2.6",
        "next-themes": "^0.4.6",
        "qrcode.react": "^4.2.0",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "sonner": "^2.0.7"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4.3.0",
        "@trivago/prettier-plugin-sort-imports": "6.0.2",
        "@types/node": "^20",
        "@types/react": "^19.2.14",
        "husky": "9.1.7",
        "lint-staged": "16.2.7",
        "prettier": "3.8.1",
        "prettier-plugin-tailwindcss": "0.7.2",
        "@types/react-dom": "^19.2.3",
        "eslint": "^9.39.4",
        "eslint-config-next": "16.1.6",
        "eslint-config-prettier": "10.1.8",
        "postcss": "^8",
        "tailwindcss": "^4.3.0",
        "typescript": "^5",
        "vitest": "^3.2.4"
    },
    "pnpm": {
